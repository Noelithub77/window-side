#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
cd "$root"
case "${1:---help}" in
  --help|-h|help)
    cat <<'HELP'
Usage: ./ops <command>

  ui:dev [--window]     Vite on 5199; --window opens Tauri only inside OmaBox
  ui:check              Typecheck, strict oxlint and build
  ui:bindings           Generate command/type bindings from Rust
  ui:bindings:check     Reject stale bindings
  ui:test               Chromium interaction tests against the Vite build
  gui:smoke --output DIR  Real WebKitGTK fixture smoke in OmaBox
  icons                 Regenerate tracked icons with rsvg-convert (dev only)
  icons:check           Reject stale generated icons
  check                 Run unit tests, Clippy and CLI/installer fixtures; no VM or desktop actions
  check:release         Run those checks against the optimized release
  ci:run [--release]    Dispatch CI on main and watch it; --release warms the release cache
  test:install          Check installer changes inside a temporary prefix
  release:build         Build the optimized ws binary with the locked dependencies
  release:package --output DIR  Archive the release binary, installer and checksums
  aur:prepare --source-archive FILE --output DIR  Generate checksummed AUR metadata
  test:first-boot        Check readiness and rollback with a fake guest
  guest:check            Read-only script/guard/driver checks in the running QEMU guest
  build                 Build the native ws binary with the existing Cargo cache
  dev                   Build and replace this checkout's development app
  gui:test --output DIR Check onboarding, setup, overview and settings in OmaBox
  gui:tray --output DIR  Check tray, window close/reopen and single-instance behavior in OmaBox
  gui:installed --binary FILE --output DIR  Open an installed binary in a fresh OmaBox HOME

The GUI test uses synthetic hardware in a fresh HOME, no guest disk or credentials.
DIR must be a new absolute directory. Requires built target/debug/ws, omabox,
jq and a built UI. Chromium interaction tests use Playwright. It never launches or restarts the live desktop.
HELP
    ;;
  ui:dev) shift; exec bash "$root/scripts/ui-dev.sh" "$@" ;;
  ui:check) pnpm -C ui typecheck; pnpm -C ui lint; exec pnpm -C ui build ;;
  ui:bindings) WS_UPDATE_BINDINGS=1 exec cargo test -j 2 app::bindings::tests::export_bindings ;;
  ui:bindings:check) exec cargo test -j 2 app::bindings::tests::export_bindings ;;
  ui:test) exec pnpm -C ui exec playwright test ;;
  gui:smoke) shift; exec bash "$root/scripts/gui-smoke.sh" "$@" ;;
  icons) shift; exec bash "$root/scripts/icons.sh" "$@" ;;
  icons:check) shift; exec bash "$root/scripts/icons.sh" check "$@" ;;
  check)
    "$root/ops" icons:check
    "$root/ops" ui:check
    cargo test -j 2
    cargo clippy -j 2 --all-targets -- -D warnings
    cargo build -j 2
    bash "$root/tests/first-boot.sh"
    bash "$root/tests/packages.sh"
    bash "$root/tests/icon-packaging.sh"
    exec bash "$root/tests/install.sh"
    ;;
  check:release)
    "$root/ops" icons:check
    "$root/ops" ui:check
    cargo test --release --locked -j 2
    cargo clippy --release --locked -j 2 --all-targets -- -D warnings
    cargo build --release --locked -j 2
    WS_TEST_BINARY="$root/target/release/ws" bash "$root/tests/first-boot.sh"
    WS_TEST_BINARY="$root/target/release/ws" bash "$root/tests/packages.sh"
    bash "$root/tests/icon-packaging.sh"
    exec bash "$root/tests/install.sh"
    ;;
  ci:run) shift; exec bash "$root/scripts/ci-run.sh" "$@" ;;
  test:install) exec bash "$root/tests/install.sh" ;;
  release:build) pnpm -C ui install --frozen-lockfile; pnpm -C ui build; exec cargo build --release --locked -j 2 ;;
  release:package) shift; exec bash "$root/scripts/package-release.sh" "$@" ;;
  aur:prepare) shift; exec bash "$root/scripts/prepare-aur.sh" "$@" ;;
  test:first-boot) exec bash "$root/tests/first-boot.sh" ;;
  guest:check) exec bash "$root/tests/guest-check.sh" ;;
  build) pnpm -C ui build; exec cargo build -j 2 ;;
  dev) shift; exec "$root/scripts/dev.sh" "$@" ;;
  gui:test) shift; exec "$root/scripts/gui-test.sh" "$@" ;;
  gui:tray) shift; exec bash "$root/scripts/tray-test.sh" "$@" ;;
  gui:installed) shift; exec "$root/scripts/installed-gui-test.sh" "$@" ;;
  *) echo 'Use ./ops --help' >&2; exit 2 ;;
esac
