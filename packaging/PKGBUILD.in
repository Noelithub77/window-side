# Maintainer: Noel Georgi
pkgname=window-side
pkgver=0.1.0
pkgrel=1
pkgdesc='Use your dual-boot Windows installation as a headless KVM guest'
arch=('x86_64')
url='https://github.com/Noelithub77/window-side'
license=('GPL-2.0-or-later')
depends=('glibc' 'gcc-libs' 'webkit2gtk-4.1' 'gtk3' 'openssl'
         'wayland' 'vulkan-icd-loader' 'libvirt' 'qemu-base' 'swtpm' 'dnsmasq'
         'edk2-ovmf' 'virt-viewer' 'libsecret' 'libisoburn' 'libarchive' 'udisks2'
         'dosfstools' 'device-mapper' 'pciutils' 'polkit' 'curl' 'openssh'
         'fontconfig' 'fuse3' 'libdecor' 'libxi' 'libxss' 'libxinerama'
         'libxcursor' 'libxpresent' 'libxfixes' 'libxrandr' 'libxkbcommon'
         'libglvnd' 'nettle' 'libusbredir' 'libpulse' 'libpipewire'
         'libsamplerate' 'libunwind' 'elfutils' 'ttf-dejavu')
makedepends=('rust' 'base-devel' 'pkgconf' 'nodejs' 'pnpm' 'cmake' 'wayland-protocols' 'spice-protocol' 'python')
checkdepends=('jq' 'ripgrep' 'desktop-file-utils')
optdepends=('hyprland: focus the existing Windows viewer')
conflicts=('ws')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Generated from the reviewed tag archive by ./ops aur:prepare.
sha256sums=('@SHA256@')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target x86_64-unknown-linux-gnu
  pnpm -C ui install --frozen-lockfile
}

build() {
  cd "$pkgname-$pkgver"
  pnpm -C ui build
  bash scripts/looking-glass.sh build
  cargo build --release --frozen -j 2
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --release --frozen -j 2
  WS_TEST_BINARY="$PWD/target/release/ws" bash tests/first-boot.sh
  bash tests/install.sh
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/ws "$pkgdir/usr/bin/ws"
  install -Dm755 target/libexec/window-side/window-side-viewer "$pkgdir/usr/libexec/window-side/window-side-viewer"
  install -Dm644 packaging/window-side.desktop "$pkgdir/usr/share/applications/window-side.desktop"
  install -Dm644 packaging/window-side-viewer.desktop "$pkgdir/usr/share/applications/window-side-viewer.desktop"
  mkdir -p "$pkgdir/usr/share/icons"
  cp -R icons/hicolor "$pkgdir/usr/share/icons/"
  if command -v gtk-update-icon-cache >/dev/null; then
    gtk-update-icon-cache -f -t "$pkgdir/usr/share/icons/hicolor" || true
  fi
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/window-side/LICENSE"
  install -Dm644 third_party/looking-glass/LICENSE "$pkgdir/usr/share/licenses/window-side/looking-glass/LICENSE"
}
