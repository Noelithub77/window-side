+static void updateCaptureChord(int sc, bool down)
+{
+  const bool repeat = down && g_state.hotkeyDown[sc];
+  g_state.hotkeyDown[sc] = down;
+  if (!g_params.ctrlAltCapture)
+    return;
+
+  const bool modifier = sc == KEY_LEFTCTRL || sc == KEY_LEFTALT;
+  if (down)
+  {
+    if (!modifier || app_isOverlayMode())
+      g_state.captureChordArmed = false;
+    else if (!repeat && g_state.hotkeyDown[KEY_LEFTCTRL] &&
+        g_state.hotkeyDown[KEY_LEFTALT])
+    {
+      bool otherKey = false;
+      for (int key = 1; key < KEY_MAX; ++key)
+        if (key != KEY_LEFTCTRL && key != KEY_LEFTALT &&
+            g_state.hotkeyDown[key])
+          otherKey = true;
+      g_state.captureChordArmed = !otherKey;
+    }
+    return;
+  }
+
+  if (modifier && g_state.captureChordArmed)
+  {
+    g_state.captureChordArmed = false;
+    if (!app_isOverlayMode() && (g_cursor.grab || lgInput_available()))
+    {
+      // Release both guest modifiers before the compositor can take focus.
+      lgInput_releaseKeys();
+      core_setGrab(!g_cursor.grab);
+    }
+  }
+}
+
 void app_handleKeyPressInternal(int sc)
 {
+  if (sc <= KEY_RESERVED || sc >= KEY_MAX)
+    return;
+
+  const bool repeat = g_state.hotkeyDown[sc];
+  updateCaptureChord(sc, true);
+  if (g_params.overlayKey != KEY_RESERVED && sc == g_params.overlayKey)
+  {
+    if (!repeat)
+    {
+      lgInput_releaseKeys();
+      app_setOverlay(!app_isOverlayMode());
+    }
+    return;
+  }
+
   if (sc == KEY_LEFTSHIFT)
     atomic_fetch_or_explicit(&g_state.keyModifiers,
         KEY_MODIFIER_LEFT_SHIFT, memory_order_acq_rel);
