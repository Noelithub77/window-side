+static void testCaptureChord(void)
+{
+  for (int order = 0; order < 2; ++order)
+    for (int release = 0; release < 2; ++release)
+      for (int captured = 0; captured < 2; ++captured)
+      {
+        init();
+        g_params.ctrlAltCapture = true;
+        g_cursor.grab = captured;
+        const int first = order ? KEY_LEFTALT : KEY_LEFTCTRL;
+        const int second = order ? KEY_LEFTCTRL : KEY_LEFTALT;
+        app_handleKeyPress(first);
+        app_handleKeyPress(second);
+        app_handleKeyPress(second);
+        CHECK(t.grabN == 0);
+        CHECK(g_state.captureChordArmed);
+        app_handleKeyRelease(release ? first : second);
+        CHECK(t.grabN == 1);
+        CHECK(t.grab == !captured);
+        CHECK(t.releaseN == 1);
+        app_handleKeyRelease(release ? second : first);
+        CHECK(t.grabN == 1);
+        CHECK(!g_state.captureChordArmed);
+        fini();
+      }
+}
+
+static void testCaptureShortcuts(void)
+{
+  const int shortcuts[] = { KEY_DELETE, KEY_A, KEY_LEFTSHIFT, KEY_RIGHTALT };
+  for (unsigned int i = 0; i < ARRAY_LENGTH(shortcuts); ++i)
+  {
+    init();
+    g_params.ctrlAltCapture = true;
+    app_handleKeyPress(KEY_LEFTCTRL);
+    app_handleKeyPress(KEY_LEFTALT);
+    app_handleKeyPress(shortcuts[i]);
+    app_handleKeyRelease(shortcuts[i]);
+    app_handleKeyPress(KEY_LEFTALT); // repeat must not rearm the chord
+    app_handleKeyRelease(KEY_LEFTALT);
+    app_handleKeyRelease(KEY_LEFTCTRL);
+    CHECK(t.grabN == 0);
+    CHECK(t.releaseN == 0);
+    checkKey(2, true, shortcuts[i]);
+    checkKey(3, false, shortcuts[i]);
+    fini();
+  }
+
+  init();
+  g_params.ctrlAltCapture = true;
+  app_handleKeyPress(KEY_A);
+  app_handleKeyPress(KEY_LEFTCTRL);
+  app_handleKeyPress(KEY_LEFTALT);
+  app_handleKeyRelease(KEY_LEFTALT);
+  app_handleKeyRelease(KEY_LEFTCTRL);
+  CHECK(t.grabN == 0);
+  CHECK(t.releaseN == 0);
+  app_handleKeyRelease(KEY_A);
+  app_handleKeyPress(KEY_HOME);
+  app_handleKeyRelease(KEY_HOME);
+  checkKey(6, true, KEY_HOME);
+  checkKey(7, false, KEY_HOME);
+  app_handleKeyPress(KEY_RIGHTCTRL);
+  app_handleKeyPress(KEY_RIGHTALT);
+  app_handleKeyRelease(KEY_RIGHTALT);
+  app_handleKeyRelease(KEY_RIGHTCTRL);
+  CHECK(t.grabN == 0);
+  fini();
+}
+
+static void testCaptureReset(void)
+{
+  init();
+  g_params.ctrlAltCapture = true;
+  g_params.releaseKeysOnFocusLoss = true;
+  app_handleKeyPress(KEY_LEFTCTRL);
+  app_handleKeyPress(KEY_LEFTALT);
+  CHECK(g_state.captureChordArmed);
+  app_handleFocusEvent(false);
+  CHECK(!g_state.captureChordArmed);
+  CHECK(!g_state.hotkeyDown[KEY_LEFTCTRL]);
+  app_handleFocusEvent(true);
+  app_handleKeyRelease(KEY_LEFTALT);
+  app_handleKeyRelease(KEY_LEFTCTRL);
+  CHECK(t.grabN == 0);
+  app_handleKeyPress(KEY_LEFTCTRL);
+  app_handleKeyPress(KEY_LEFTALT);
+  app_handleKeyRelease(KEY_LEFTCTRL);
+  app_handleKeyRelease(KEY_LEFTALT);
+  CHECK(t.grabN == 1);
+  fini();
+}
+
+static void testOverlayKey(void)
+{
+  init();
+  g_params.escapeKey = KEY_SCROLLLOCK;
+  g_params.overlayKey = KEY_INSERT;
+  g_params.ctrlAltCapture = true;
+  app_handleKeyPress(KEY_INSERT);
+  CHECK(app_isOverlayMode());
+  app_handleKeyPress(KEY_INSERT);
+  CHECK(app_isOverlayMode());
+  app_handleKeyRelease(KEY_INSERT);
+  CHECK(app_isOverlayMode());
+  app_handleKeyPress(KEY_INSERT);
+  CHECK(!app_isOverlayMode());
+  app_handleKeyRelease(KEY_INSERT);
+  CHECK(t.keyN == 0);
+  CHECK(t.grabN == 0);
+
+  app_handleKeyPress(KEY_INSERT);
+  app_handleKeyRelease(KEY_INSERT);
+  app_handleKeyPress(KEY_ESC);
+  app_handleKeyRelease(KEY_ESC);
+  CHECK(!app_isOverlayMode());
+  CHECK(t.grabN == 0);
+  fini();
+}
