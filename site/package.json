{
  "name": "window-side-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "oxlint --type-aware --deny-warnings",
    "typecheck": "tsc --noEmit",
    "deploy": "cf deploy --prebuilt",
    "deploy:check": "cf deploy --prebuilt --dry-run"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.2",
    "cf": "1.0.0-beta.18",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "~7.0.2",
    "vite": "^8"
  }
}
